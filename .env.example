# Copy to .env.local for local work. Set the same two in Vercel for every environment.

# Resend API key. Without it /api/enquire answers 503 and both forms show the desk address as text.
RESEND_API_KEY=

# The verified sender, e.g. "Danmar Empire <desk@mail.danmarempire.com>". Must be on a domain
# or subdomain verified in Resend.
RESEND_FROM=
