# Copy to .env.local for local work. Set the same two in Vercel for every environment.

# Resend API key. Without it /api/enquire answers 503 and both forms show the desk address as text.
RESEND_API_KEY=

# The verified sender, e.g. "Danmar Empire <desk@mail.danmarempire.com>". Must be on a domain
# or subdomain verified in Resend.
RESEND_FROM=

# PropTx (TRREB) RESO Web API, access level "Brokerage's Listings". The bearer token goes
# HERE: a long value with two dots in it. Without it the feed is off and the Collection
# shows its empty state. Never commit a value; the same names are set in Vercel.
PROPTX_TOKEN=
# The brokerage's ListOfficeKey, a short plain key (Danmar's is 249200). When set, the
# active-listing query filters on it; when blank, on ListOfficeName containing DANMAR.
# Never the token: a token here is ignored and logged, and the Collection stays empty
# until PROPTX_TOKEN is set.
PROPTX_OFFICE_KEY=249200
# Shared secret for GET /api/revalidate?secret=..., which drops the cached feed read so
# a new listing shows at once. Without it the route answers 503.
REVALIDATE_SECRET=
