{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "metadata",
          "generateMetadata",
          "generateStaticParams",
          "dynamicParams",
          "dynamic",
          "revalidate",
          "runtime",
          "viewport",
          "generateViewport",
          "alt",
          "size",
          "contentType"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "src/components/ui/**"
  ]
}
